{
  "id": "cta-banner",
  "label": "CTA banner",
  "section": {
    "id": "section-cta",
    "classes": ["studio-section", "cta-banner"],
    "layout": { "type": "grid", "columns": 1, "gap": "1rem" },
    "responsive": { "default": { "columns": 1 } },
    "rows": [{
      "id": "row-cta",
      "columns": [{
        "id": "col-cta",
        "width": "100%",
        "elements": [
          {
            "id": "el-cta-h",
            "type": "text",
            "tag": "h2",
            "content": "Ready to get started?",
            "classes": ["cta-title"],
            "styles": { "textAlign": "center" }
          },
          {
            "id": "el-cta-p",
            "type": "text",
            "tag": "p",
            "content": "Build your site with Studio and publish in minutes.",
            "classes": ["cta-subtitle"],
            "styles": { "textAlign": "center" }
          },
          {
            "id": "el-cta-btn",
            "type": "button",
            "content": "Start building",
            "href": "#",
            "classes": ["studio-btn", "btn-primary"]
          }
        ]
      }]
    }]
  }
}
