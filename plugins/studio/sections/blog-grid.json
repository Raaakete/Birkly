{
  "id": "blog-grid",
  "label": "Blog grid",
  "section": {
    "id": "section-blog-grid",
    "classes": ["studio-section", "blog-section"],
    "layout": { "type": "grid", "columns": 1, "gap": "1.5rem" },
    "responsive": { "default": { "columns": 1 }, "desktop": { "columns": 1 } },
    "rows": [{
      "id": "row-blog",
      "columns": [{
        "id": "col-blog",
        "width": "100%",
        "elements": [
          {
            "id": "el-blog-title",
            "type": "text",
            "tag": "h2",
            "content": "Latest posts",
            "classes": ["section-title"],
            "styles": { "textAlign": "center" }
          },
          {
            "id": "el-blog-binding",
            "type": "binding",
            "bindingType": "filtered",
            "collection": "blog",
            "filterField": "status",
            "filterValue": "published",
            "orderBy": "newest",
            "limit": 3,
            "itemTemplate": "<article class=\"post-card\"><h3>{ title }</h3><p class=\"excerpt\">{ excerpt }</p><a class=\"read-more\" href=\"#\">Read more</a></article>"
          }
        ]
      }]
    }]
  }
}
