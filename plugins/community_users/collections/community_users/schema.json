{
  "fields": [
    {
      "name": "username",
      "type": "text",
      "label": "Username",
      "required": true,
      "validation": { "min": 3, "max": 32, "pattern": "^[a-zA-Z0-9_]+$" },
      "unique": true
    },
    {
      "name": "email",
      "type": "text",
      "label": "Email",
      "required": true,
      "validation": { "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
      "unique": true
    },
    {
      "name": "password_hash",
      "type": "text",
      "label": "Password Hash",
      "required": true,
      "private": true
    },
    {
      "name": "avatar",
      "type": "media",
      "label": "Avatar",
      "required": false
    },
    {
      "name": "bio",
      "type": "textarea",
      "label": "Bio",
      "required": false,
      "validation": { "max": 500 }
    },
    {
      "name": "created_at",
      "type": "text",
      "label": "Created At",
      "required": true,
      "private": true
    },
    {
      "name": "updated_at",
      "type": "text",
      "label": "Updated At",
      "required": true,
      "private": true
    },
    {
      "name": "status",
      "type": "select",
      "label": "Status",
      "required": true,
      "options": [
        { "label": "Active", "value": "active" },
        { "label": "Pending", "value": "pending" },
        { "label": "Banned", "value": "banned" }
      ],
      "default": "active",
      "private": true
    }
  ]
} 