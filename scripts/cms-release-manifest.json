{
  "manifest_version": 2,
  "cms_version": "1.0.0",
  "phase": "P36",
  "description": "Runtime-only CMS release zip. Includes bundled starters/ for offline/local onboarding fallback. Official plugins and most dev tooling are not shipped.",
  "release_zip_name_pattern": "Birkly-{version}.zip",
  "runtime_skeleton_files": [
    "content/.gitkeep",
    "media/.gitkeep",
    "users/.gitkeep",
    "settings/.gitkeep",
    "logs/.gitkeep",
    "temp/.gitkeep",
    "cache/.gitkeep",
    "project/.gitkeep",
    "plugins/README.md",
    "plugins/.gitkeep"
  ],
  "excludes": [
    "fieldtypes/**/tests/**",
    "archive/**",
    "catalog/**",
    "composer.json",
    "database/**",
    "demo-content/**",
    "demo-website/**",
    "dist/**",
    "docker/**",
    "docker-compose.yml",
    "Dockerfile",
    "OPEN-ME-FIRST.txt",
    "tests/**",
    "docs/**",
    "invite.php",
    "mcp-bridge.js",
    "nginx.conf.example",
    "reference-projects/**",
    "release/**",
    "SECURITY_AUDIT_REPORT.md",
    "src/**",
    "templates/**",
    "test-*.php",
    "tmp/**",
    "tools/**",
    "test-server.php",
    "birkly-hydrate.js",
    "plugins/*",
    "!plugins/README.md",
    "!plugins/.gitkeep",
    "users/**",
    "cache/**",
    "logs/**",
    "temp/**",
    "media/**",
    "settings/**",
    "data/**",
    "content/**",
    "!content/.gitkeep",
    "project/**",
    "!project/.gitkeep",
    "scripts/*",
    "!scripts/build-cms-release.sh",
    "!scripts/build-plugin-zip.sh",
    "!scripts/create-default-user.php",
    ".env",
    "config.php",
    ".git/**",
    ".github/**",
    ".cursor/**"
  ],
  "empty_plugins_dir": true,
  "plugins_dir_shipped_files": [
    "plugins/README.md",
    "plugins/.gitkeep"
  ],
  "official_plugin_ids": [
    "commerce",
    "events",
    "automation",
    "user_management",
    "studio"
  ],
  "official_marketplace_slugs": {
    "commerce": "birkly-commerce",
    "events": "birkly-events",
    "automation": "birkly-automation",
    "user_management": "birkly-user-management",
    "studio": "birkly-studio"
  },
  "dev_only_plugin_ids": [
    "sample-plugin"
  ],
  "embed_sync_excludes": [
    "plugins/**",
    "!plugins/README.md",
    "!plugins/.gitkeep",
    "demo-content/**",
    "demo-website/**",
    "docs/**",
    "tests/**"
  ],
  "launcher_release_files": [
    "Birkly Launch.exe",
    "birkly-launch-linux"
  ],
  "launcher_release_dirs": [
    "Birkly Launch.app"
  ],
  "executable_files": [
    "start-server.sh",
    "start-server.bat",
    "check-php.sh",
    "check-php.bat",
    "install-php-windows.bat",
    "Birkly Launch.exe",
    "birkly-launch-linux",
    "Birkly Launch.app/Contents/MacOS/birkly-launch"
  ],
  "fresh_install": {
    "active_plugins": [],
    "onboarding_marketplace_hint": true
  },
  "grandfather_policy": "P10-D5 — existing installs retain local plugins/; updates only via marketplace"
}
