# Birkly CMS — environment template (P16-M2)
# Copy to .env when using env-based overrides. Never commit .env or config.php secrets.

# Marketplace registry (overrides settings/marketplace.json when set)
BIRKLY_MARKETPLACE_URL=https://marketplace.birkly.cloud

# Ops platform relay (P34-M18) — customer installs; triage moves to ops.birkly.cloud
# BIRKLY_FEEDBACK_RELAY_URL=https://ops.birkly.cloud/api/ops/v1/feedback
# BIRKLY_FEEDBACK_RELAY_SECRET=<same as OPS_FEEDBACK_HMAC_SECRET on Ops>
# BIRKLY_OPS_UPDATES_URL=https://ops.birkly.cloud/api/ops/v1/releases/check
# BIRKLY_RELEASE_CHANNEL=stable

# Optional Birkly Cloud account link (P13 / P16)
BIRKLY_CLOUD_OAUTH_URL=https://cloud.birkly.io

# Dev/test only — never set in production
# BIRKLY_CLOUD_ACCOUNT_MOCK=1
# BIRKLY_CLOUD_ACCOUNT_MOCK_EMAIL=mock@birkly.cloud

# Production smoke (cron / digest)
# BIRKLY_SMOKE_BASE_URL=https://your-cms.example.com
# BIRKLY_MARKETPLACE_URL=https://marketplace.birkly.cloud
# BIRKLY_SMOKE_SKIP_MARKETPLACE=0

# Agent digest (cloud VM only)
# RESEND_API_KEY=
# AGENT_DIGEST_FROM=
# AGENT_DIGEST_TO=
