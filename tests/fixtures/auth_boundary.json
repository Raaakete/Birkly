{
  "description": "M5 security regression fixtures — unauthenticated admin endpoints must deny; public read stays open on localhost.",
  "probes": [
    {
      "label": "content.php list_collections",
      "path": "/api/content.php?action=list_collections",
      "method": "GET",
      "expect": [401, 403]
    },
    {
      "label": "content.php get_entry",
      "path": "/api/content.php?action=get_entry&collection=test&id=1",
      "method": "GET",
      "expect": [401, 403]
    },
    {
      "label": "content.php list_entries",
      "path": "/api/content.php?action=list_entries&collection=test",
      "method": "GET",
      "expect": [401, 403]
    },
    {
      "label": "legacy media.php",
      "path": "/api/media.php?action=list",
      "method": "GET",
      "expect": [401, 403]
    },
    {
      "label": "admin_media.php list",
      "path": "/api/admin_media.php?action=list",
      "method": "GET",
      "expect": [401, 403]
    },
    {
      "label": "admin_media.php upload",
      "path": "/api/admin_media.php?action=upload",
      "method": "GET",
      "expect": [401, 403]
    },
    {
      "label": "public.php list_collections",
      "path": "/api/public.php?action=list_collections",
      "method": "GET",
      "expect": [200]
    },
    {
      "label": "page_bundle.php GET requires requests",
      "path": "/api/page_bundle.php",
      "method": "GET",
      "expect": [400]
    },
    {
      "label": "page_bundle.php empty body",
      "path": "/api/page_bundle.php",
      "method": "POST",
      "body": "{}",
      "content_type": "application/json",
      "expect": [400]
    },
    {
      "label": "page_snapshot.php invalid page",
      "path": "/api/page_snapshot.php?page=",
      "method": "GET",
      "expect": [400]
    },
    {
      "label": "page_snapshot.php missing snapshot",
      "path": "/api/page_snapshot.php?page=nonexistent-test-page",
      "method": "GET",
      "expect": [404]
    }
  ]
}
