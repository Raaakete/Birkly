{
    "section": "V-PHP-03",
    "title": "Ordering newest / oldest / last-updated / order",
    "cases": [
        {
            "name": "ordered by newest",
            "html": "{for each entry in 'posts' ordered by newest}[{title}]{endfor}",
            "data": {
                "posts": [
                    { "title": "Old", "created_at": "2024-01-01", "updated_at": "2024-06-01", "order": 3 },
                    { "title": "Mid", "created_at": "2025-01-01", "updated_at": "2026-01-01", "order": 1 },
                    { "title": "New", "created_at": "2026-01-01", "updated_at": "2024-01-01", "order": 2 }
                ]
            }
        },
        {
            "name": "ordered by oldest",
            "html": "{for each entry in 'posts' ordered by oldest}[{title}]{endfor}",
            "data": {
                "posts": [
                    { "title": "Old", "created_at": "2024-01-01" },
                    { "title": "Mid", "created_at": "2025-01-01" },
                    { "title": "New", "created_at": "2026-01-01" }
                ]
            }
        },
        {
            "name": "ordered by last-updated",
            "html": "{for each entry in 'posts' ordered by last-updated}[{title}]{endfor}",
            "data": {
                "posts": [
                    { "title": "Old", "created_at": "2024-01-01", "updated_at": "2024-06-01" },
                    { "title": "Mid", "created_at": "2025-01-01", "updated_at": "2026-01-01" },
                    { "title": "New", "created_at": "2026-01-01", "updated_at": "2024-01-01" }
                ]
            }
        },
        {
            "name": "ordered by order uses order field",
            "html": "{for each entry in 'posts' ordered by order}[{title}]{endfor}",
            "data": {
                "posts": [
                    { "title": "Old", "order": 3 },
                    { "title": "Mid", "order": 1 },
                    { "title": "New", "order": 2 }
                ]
            }
        },
        {
            "name": "ordered by order falls back to sort_order",
            "html": "{for each entry in 'nav' ordered by order}[{title}]{endfor}",
            "data": {
                "nav": [
                    { "title": "B", "sort_order": 2 },
                    { "title": "A", "sort_order": 1 }
                ]
            }
        },
        {
            "name": "ordered by newest with datetime timestamps",
            "html": "{for each entry in 'posts' ordered by newest}[{title}]{endfor}",
            "data": {
                "posts": [
                    { "title": "Morning", "created_at": "2026-03-01T08:00:00" },
                    { "title": "Evening", "created_at": "2026-03-01T20:15:00" },
                    { "title": "Noon", "created_at": "2026-03-01T12:00:00" }
                ]
            }
        },
        {
            "name": "missing created_at falls back consistently",
            "html": "{for each entry in 'posts' ordered by newest}[{title}]{endfor}",
            "data": {
                "posts": [
                    { "title": "NoDate" },
                    { "title": "Dated", "created_at": "2026-01-01" },
                    { "title": "AlsoNoDate" }
                ]
            }
        },
        {
            "name": "ordered by order with mixed string numbers",
            "html": "{for each entry in 'nav' ordered by order}[{title}]{endfor}",
            "data": {
                "nav": [
                    { "title": "Ten", "order": "10" },
                    { "title": "Two", "order": 2 },
                    { "title": "One", "order": "1" }
                ]
            }
        }
    ]
}
