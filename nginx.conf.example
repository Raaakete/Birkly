# Birkly Nginx config example
server {
    listen 80;
    server_name birkly.local;
    root /path/to/birkly;
    index index.php;

    # Token-gated Commerce import cron. Exact match wins over the deny below.
    location = /scripts/commerce-import-sync.php {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root/scripts/commerce-import-sync.php;
    }

    # Private trees. Same set as docker/nginx-site.conf. media/ stays public.
    location ~* ^/(core|settings|users|content|data|cache|logs|scripts|tests)(/|$) {
        deny all;
    }

    # Git metadata is never web-readable — project/.git holds the managed
    # worktree used by Settings → Project → Git sync.
    location ~* /\.git {
        deny all;
    }

    location ^~ /project/.git {
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Same-host project sites: route /project/ and project HTML through PHP (SSR + client).
    location = /project/ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
    }

    location ~ ^/project/.+\.html$ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
    }

    location ~ ^/(api|admin|media)/ {
        try_files $uri =404;
    }

    location ~ ^/api/ai_chat\.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 300s;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_index index.php;
        fastcgi_read_timeout 120s;
    }

    # Security headers
    add_header X-Content-Type-Options "nosniff";
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy "strict-origin-when-cross-origin";
} 