# HaruCMS Production .gitignore

# User data directories (should not be committed)
users/
content/
media/
logs/
settings/
backups/
temp/

# Environment and configuration files
.env
config.php
*.local.php

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# PHP dependencies
vendor/
composer.lock

# Temporary files
*.tmp
*.temp
*.log

# Backup files
*.bak
*.backup
*.old

# Cache files
cache/
*.cache

# Upload directories (user content)
uploads/

# Development and test files
*.dev.php
*.test.php
debug.php
test_*.php
test_*.html
debug-*.html
demo-*.html

# Session files
sess_*
