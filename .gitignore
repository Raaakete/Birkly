# Birkly Production .gitignore

# User data directories (should not be committed)
users/
# Local content overrides — demo seed under content/collections/ is tracked for OSS.
content/
!content/collections/
!content/collections/**
media/
logs/
settings/*
!settings/help_manifest.json
backups/
temp/

# Environment and configuration files
.env
config.php
*.local.php

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local SQLite databases (per-install; schema lives in database/init.php)
database/*.db

# Plugin runtime state (per-install; plugin code lives under plugins/)
data/plugins/

# AI runtime data (conversations, approvals)
data/ai_conversations/*
!data/ai_conversations/.gitkeep
data/ai_approvals/*
!data/ai_approvals/.gitkeep
data/feedback/
data/mcp_audit/
data/mcp_rate/
data/demo_social/*
!data/demo_social/.gitkeep
data/analytics/*
!data/analytics/.gitkeep

# PHP dependencies
vendor/
composer.lock

# Temporary files
tmp/
*.tmp
*.temp
*.log

# Backup files
*.bak
*.backup
*.old

# Cache files
cache/
*.cache

# Upload directories (user content)
uploads/

# Development and test files
*.dev.php
*.test.php
debug.php
test_*.php
test_*.html
debug-*.html
demo-*.html

# Session files
sess_*
dist/

# Test-generated project fixtures (P38 AI Project Gateway test runs)
project/pages/
project/.well-known/agent-guide.json
project/.well-known/brand-context.json

# Project git sync (P59) writes these into the local install's project/
project/.gitignore
