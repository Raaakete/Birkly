# Birkly Production .gitignore

# User data directories (should not be committed)
users/
content/
media/
logs/
settings/*
!settings/help_manifest.json
backups/
temp/

# Exception: Demo content collections (shipped with CMS)
# First un-ignore the collections directory
!content/collections/
# Then un-ignore specific demo collections
!content/collections/blog/
!content/collections/services/
!content/collections/contact/
!content/collections/about/
!content/collections/site_elements/
!content/collections/blog/**
!content/collections/services/**
!content/collections/contact/**
!content/collections/about/**
!content/collections/site_elements/**

# Environment and configuration files
.env
config.php
*.local.php

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local SQLite databases (per-install; schema lives in database/init.php)
database/*.db

# Plugin runtime state (per-install; plugin code lives under plugins/)
data/plugins/

# AI runtime data (conversations, approvals)
data/ai_*
data/feedback/
data/mcp_audit/
data/mcp_rate/

# PHP dependencies
vendor/
composer.lock

# Temporary files
*.tmp
*.temp
*.log

# Backup files
*.bak
*.backup
*.old

# Cache files
cache/
*.cache

# Upload directories (user content)
uploads/

# Development and test files
*.dev.php
*.test.php
debug.php
test_*.php
test_*.html
debug-*.html
demo-*.html

# Session files
sess_*
