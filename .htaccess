# Birkly .htaccess

RewriteEngine On

# Private trees. PHP can still write these directories. HTTP cannot read them.
# scripts/commerce-import-sync.php stays reachable and checks its own cron token.
RewriteRule ^scripts/(?!commerce-import-sync\.php$) - [F,L,NC]
RewriteRule ^scripts/?$ - [F,L,NC]
RewriteRule ^(?:core|settings|users|content|data|cache|logs|tests)(?:/|$) - [F,L,NC]
RewriteRule (?:^|/)\.git(?:/|$) - [F,L,NC]

# MCP OAuth (P4.1-M3) — well-known + token endpoints
RewriteRule ^\.well-known/oauth-protected-resource(/.*)?$ api/oauth_protected_resource.php [L,QSA]
RewriteRule ^\.well-known/oauth-authorization-server(/.*)?$ api/oauth_authorization_server.php [L,QSA]
RewriteRule ^\.well-known/brand-context\.json$ api/well_known_brand_context.php [L,QSA]
RewriteRule ^oauth/authorize$ api/oauth_authorize.php [L,QSA]
RewriteRule ^oauth/token$ api/oauth_token.php [L,QSA]
RewriteRule ^oauth/register$ api/oauth_register.php [L,QSA]
RewriteRule ^authorize$ api/oauth_authorize.php [L,QSA]
RewriteRule ^mcp(/.*)?$ api/mcp.php [L,QSA]

# Studio published sites (P22) — slug query param for LiteSpeed/internal rewrites
RewriteRule ^site/([^/]+)/styles\.css$ api/studio_public.php?slug=$1&page=styles.css [L,QSA]
RewriteRule ^site/([^/]+)/([^/]+)/?$ api/studio_public.php?slug=$1&page=$2 [L,QSA]
RewriteRule ^site/([^/]+)/?$ api/studio_public.php?slug=$1 [L,QSA]
RewriteRule ^site/?$ api/studio_public.php [L,QSA]

# Project HTML and /project/ home must reach PHP (SSR + birkly-client injection)
RewriteRule ^demo-website(/.*)?$ index.php [L,QSA]
RewriteRule ^project/?$ index.php [L,QSA]
RewriteRule ^project/.+\.html$ index.php [L,QSA]

# Connector branding for MCP clients (Claude connector icon)
RewriteRule ^favicon\.ico$ admin/assets/birkly-icon.svg [L]

# Serve existing files directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Don't rewrite PHP files - let them execute
RewriteCond %{REQUEST_FILENAME} \.php$
RewriteRule ^ - [L]

# Redirect /admin to PHP admin panel (not static HTML)
RewriteRule ^admin($|/) /admin/index.php?page=dashboard [L,R=302]

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
