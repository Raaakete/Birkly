{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://birkly.dev/schema/ai_presence.v1.json",
  "title": "Birkly AI Presence",
  "description": "Canonical internal brand context model for AI systems (ai_presence.v1)",
  "type": "object",
  "required": ["schema_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ai_presence.v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "official_name": { "type": "string" },
        "short_description": { "type": "string" },
        "full_description": { "type": "string" },
        "what_we_do": { "type": "string" },
        "industry": { "type": "array", "items": { "type": "string" } },
        "categories": { "type": "array", "items": { "type": "string" } },
        "locations": { "type": "array", "items": { "type": "string" } },
        "website": { "type": "string" },
        "social_profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "platform": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "best_known_for": { "type": "array", "items": { "type": "string" } },
        "differentiators": { "type": "array", "items": { "type": "string" } },
        "best_suited_for": { "type": "array", "items": { "type": "string" } },
        "not_ideal_for": { "type": "array", "items": { "type": "string" } },
        "competitive_positioning": { "type": "string" }
      }
    },
    "communication_guidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_terms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "term": { "type": "string" },
              "meaning": { "type": "string" }
            }
          }
        },
        "avoided_terms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "term": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "required_qualifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim": { "type": "string" },
              "preferred_wording": { "type": "string" }
            }
          }
        },
        "tone": { "type": "array", "items": { "type": "string" } },
        "custom_guidance": { "type": "string" }
      }
    },
    "connected_content": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string" },
          "ref_type": { "type": "string", "enum": ["entry", "collection"] },
          "collection": { "type": "string" },
          "entry_id": { "type": "string" },
          "slug": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["supported", "pending_review", "unsupported", "conflicting", "expired"]
          },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "related_content": { "type": "array", "items": { "type": "object" } },
          "last_reviewed_at": { "type": "string" },
          "expires_at": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["cms_content", "external_url", "upload", "certification", "publication", "other"]
          },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "media_id": { "type": "string" },
          "publisher": { "type": "string" },
          "published_at": { "type": "string" },
          "reviewed_at": { "type": "string" },
          "verification_status": {
            "type": "string",
            "enum": ["user_verified", "unverified"]
          },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "media_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "media_id": { "type": "string" },
          "represents": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["brand", "product", "person", "place", "campaign", "concept", "claim"]
              },
              "ref": { "type": "string" }
            }
          },
          "description": { "type": "string" },
          "intended_use": { "type": "string" },
          "restrictions": { "type": "string" }
        }
      }
    },
    "products_services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["product", "service", "bundle"] },
          "short_description": { "type": "string" },
          "full_description": { "type": "string" },
          "category": { "type": "string" },
          "pricing_model": { "type": "string" },
          "best_for": { "type": "array", "items": { "type": "string" } },
          "not_for": { "type": "array", "items": { "type": "string" } },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "connected_entry": { "type": "object" },
          "public": { "type": "boolean" }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "publication_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "public_path": { "type": "string" },
        "include_json_ld": { "type": "boolean" },
        "redact_public_fields": { "type": "array", "items": { "type": "string" } },
        "public_views_enabled": { "type": "boolean" }
      }
    },
    "setup_completed_at": { "type": "string" },
    "setup_skipped_at": { "type": "string" }
  }
}
