server {
    listen 80;
    server_name yourdomain.com;
    root /path/to/harucms;

    location /api/ {
        try_files $uri =404;
        # PHP-FPM config here
    }

    location /admin/ {
        try_files $uri $uri/ /admin/index.html;
    }

    location / {
        try_files $uri $uri/ /index.php;
    }
} 